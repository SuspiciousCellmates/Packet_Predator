#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

if [ ! -x .venv/bin/python ]; then
    echo "Raspberry Pi environment is missing. Run ./scripts/setup-rpi first." >&2
    exit 1
fi

exec .venv/bin/python -m packet_predator.nrf905_diagnostics "$@"
