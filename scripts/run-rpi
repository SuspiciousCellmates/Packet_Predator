#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "usage: ./scripts/run-rpi PROFILE [--lan]" >&2
    exit 1
fi

profile_path=$1
if [ ! -f "$profile_path" ]; then
    echo "nRF905 profile not found: $profile_path" >&2
    exit 1
fi

server_host=127.0.0.1
if [ "$#" -eq 2 ]; then
    if [ "$2" != "--lan" ]; then
        echo "the only optional argument is --lan" >&2
        exit 1
    fi
    server_host=0.0.0.0
    echo "Warning: the workbench has no login. Use --lan only on a trusted development network." >&2
fi

export PACKET_PREDATOR_ADAPTER_PROFILE="$profile_path"
export PACKET_PREDATOR_HOST="$server_host"
exec ./scripts/run-local
