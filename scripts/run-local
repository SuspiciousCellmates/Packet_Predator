#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

if [ -x .venv/bin/python ]; then
    python_command=.venv/bin/python
else
    python_command=python3
fi

if ! "$python_command" -c 'import fastapi, uvicorn' 2>/dev/null; then
    echo "Laptop dependencies are missing. Run ./scripts/setup-local first." >&2
    exit 1
fi

server_host=${PACKET_PREDATOR_HOST:-127.0.0.1}
server_port=${PACKET_PREDATOR_PORT:-8000}

if [ -z "${PACKET_PREDATOR_BUILD_ID:-}" ] && command -v git >/dev/null 2>&1; then
    build_commit=$(git rev-parse --verify HEAD 2>/dev/null || true)
    if [ -n "$build_commit" ]; then
        if [ -n "$(git status --porcelain --untracked-files=normal 2>/dev/null || true)" ]; then
            build_commit="${build_commit}-dirty"
        fi
        export PACKET_PREDATOR_BUILD_ID="$build_commit"
    fi
fi

if [ -n "${PACKET_PREDATOR_ADAPTER_PROFILE:-}" ]; then
    echo "Packet Predator is starting with explicit adapter profile: $PACKET_PREDATOR_ADAPTER_PROFILE"
else
    echo "Packet Predator is starting in inspect-only mode."
fi
echo "Open http://${server_host}:${server_port}"
exec "$python_command" -m uvicorn packet_predator.web:app --host "$server_host" --port "$server_port"
